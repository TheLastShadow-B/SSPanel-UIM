{
  "clients": [
    {
      "name": "Clash Verge Rev",
      "description": "功能完善的图形化客户端",
      "format": "clash",
      "importUrl": "clash://install-config?url={sub}/clash",
      "platforms": {
        "Windows": {
          "ext": "exe",
          "file": "Clash.Verge"
        },
        "macOS": {
          "ext": "dmg",
          "file": "Clash.Verge"
        },
        "Linux": {
          "ext": "deb",
          "file": "Clash.Verge"
        }
      }
    },
    {
      "name": "CMFA",
      "description": "支持分应用代理的 Android 客户端",
      "format": "clash",
      "importUrl": "clash://install-config?url={sub}/clash&name={name}",
      "platforms": {
        "Android": {
          "ext": "apk",
          "file": "CMFA"
        }
      }
    },
    {
      "name": "Stash",
      "description": "iOS 平台强大的网络工具",
      "format": "stash",
      "importUrl": "stash://install-config?url={sub}/stash&name={name}",
      "platforms": {
        "iOS": {
          "storeUrl": "https://apps.apple.com/app/stash/id1596063349"
        }
      }
    },
    {
      "name": "Surge 5",
      "description": "iOS / macOS 商业级网络调试与代理工具",
      "format": "surge",
      "importUrl": "surge:///install-config?url={sub}/surge&name={name}",
      "platforms": {
        "iOS": {
          "storeUrl": "https://apps.apple.com/us/app/surge-5/id1442620678"
        },
        "macOS": {
          "storeUrl": "https://apps.apple.com/us/app/surge-5/id1442620678"
        }
      }
    }
  ],
  "icons": {
    "Windows": "ti-brand-windows",
    "macOS": "ti-brand-finder",
    "Android": "ti-brand-android",
    "iOS": "ti-brand-apple",
    "Linux": "ti-brand-ubuntu"
  }
}
